# Copy this file to `.env` and fill in what you have.
# You do NOT need all of them. Start with just ANTHROPIC_API_KEY.

# The BRAIN — decides which action to run. Required (unless you use --dry).
ANTHROPIC_API_KEY=sk-ant-...

# The EARS — speech to text. Only needed for real voice mode.
# Leave blank and use `npm run text` to type instead of speak.
OPENAI_API_KEY=

# Optional: for the "ask gemini ..." action
GEMINI_API_KEY=

# Which model the router uses. Cheap+fast is correct here — the router
# only has to pick a tool, not write an essay.
ROUTER_MODEL=claude-haiku-4-5-20251001

# Should Overlord speak its replies out loud? (macOS `say`)
SPEAK=true

# --- wake word -------------------------------------------------------------
WAKE_WORD=overlord

# Extra spellings to accept. Speech-to-text sometimes renders an unusual name
# as a COMPLETELY different word rather than a near-miss, and no threshold
# setting fixes that. Run `npm run tune` and it prints the line to paste here.
WAKE_ALIASES=over lord,overload,oberlord,overlard

# If the wake word keeps failing, a word whisper knows well is far more
# reliable than a rare one. Try: WAKE_WORD=computer  or  WAKE_WORD=jarvis
WAKE_THRESHOLD=0.72

# Recording sensitivity. Raise VAD_THRESHOLD if a fan or typing triggers it.
VAD_THRESHOLD=2
VAD_SILENCE=1.2
FOLLOW_UP_SECONDS=8

WHISPER_MODE=local

# --- voice and personality -------------------------------------------------
# Which macOS voice speaks. `npm run voices` lists what you have installed.
# Daniel = British, male, calm. Alex = US male. Samantha = US female.
VOICE=Daniel

# Words per minute. `say` defaults near 175 which sounds chirpy; slowing it
# down is most of what makes a voice sound composed.
VOICE_RATE=165

# Wording style for spoken replies: jarvis | plain
# Affects phrasing only - never which action runs.
PERSONA=jarvis

# Where Ollama listens. Only change this if you moved it.
OLLAMA_URL=http://localhost:11434/v1

# Hold the Mac awake while Overlord runs, so a closed lid does not end the
# session. Works on MAINS POWER only - macOS will not stay awake with the lid
# shut on battery, and no app can override that.
KEEP_AWAKE=false

# --- Spotify by name (optional, 2 minutes, free) ---------------------------
# Lets you say "play Blinding Lights" or "play the most popular song by The
# Weeknd". Without these, playback control still works - only search needs it.
#   1. developer.spotify.com/dashboard -> Create app (any name/redirect URI)
#   2. Copy Client ID and Client Secret here
# Liked Songs and private playlists need a full account login, which this
# does not do.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
