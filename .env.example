# Copy this file to `.env` and fill in what you have.
# You do NOT need all of them. Start with just ANTHROPIC_API_KEY.

# The BRAIN — decides which action to run. Required (unless you use --dry).
ANTHROPIC_API_KEY=sk-ant-...

# The EARS — speech to text. Only needed for real voice mode.
# Leave blank and use `npm run text` to type instead of speak.
OPENAI_API_KEY=sk-...

# Optional: for the "ask gemini ..." action
GEMINI_API_KEY=

# Which model the router uses. Cheap+fast is correct here — the router
# only has to pick a tool, not write an essay.
ROUTER_MODEL=claude-haiku-4-5-20251001

# Should Overlord speak its replies out loud? (macOS `say`)
SPEAK=true

# --- wake word -------------------------------------------------------------
WAKE_WORD=overlord

# Extra spellings to accept. Speech-to-text sometimes renders an unusual name
# as a COMPLETELY different word rather than a near-miss, and no threshold
# setting fixes that. Run `npm run tune` and it prints the line to paste here.
WAKE_ALIASES=over lord,overload,oberlord,overlard

# If the wake word keeps failing, a word whisper knows well is far more
# reliable than a rare one. Try: WAKE_WORD=computer  or  WAKE_WORD=jarvis
WAKE_THRESHOLD=0.72

# Recording sensitivity. Raise VAD_THRESHOLD if a fan or typing triggers it.
VAD_THRESHOLD=2
VAD_SILENCE=1.2
FOLLOW_UP_SECONDS=8

WHISPER_MODE=local
