# Copy this file to `.env` and fill in what you have.
# You do NOT need all of them. Start with just ANTHROPIC_API_KEY.

# The BRAIN - decides which action to run. Required (unless you use --dry).
ANTHROPIC_API_KEY=sk-ant-...

# The EARS - speech to text. Only needed for real voice mode.
OPENAI_API_KEY=sk-...

# Optional: for the "ask gemini ..." action
GEMINI_API_KEY=

ROUTER_MODEL=claude-haiku-4-5-20251001
SPEAK=true
