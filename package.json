{
  "name": "overlord",
  "version": "0.2.0",
  "description": "A local voice agent. Say its name -> it decides -> it acts on your Mac.",
  "type": "module",
  "bin": {
    "overlord": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js --wake",
    "ptt": "node src/index.js",
    "text": "node src/index.js --text",
    "dry": "node src/index.js --text --dry",
    "wake:test": "node test/wakeword.test.mjs",
    "doctor": "node test/doctor.mjs",
    "tune": "node test/tune.mjs",
    "wake:dry": "node src/index.js --wake --dry",
    "voices": "node test/voices.mjs",
    "brain": "node -e \"import('./src/router.js').then(m=>console.log('using:', m.brainInfo().label))\"",
    "service:install": "bash scripts/install-service.sh",
    "service:stop": "launchctl unload ~/Library/LaunchAgents/com.kabir.overlord.plist",
    "service:restart": "launchctl unload ~/Library/LaunchAgents/com.kabir.overlord.plist 2>/dev/null; launchctl load ~/Library/LaunchAgents/com.kabir.overlord.plist",
    "service:logs": "tail -f ~/Library/Logs/Overlord/overlord.log"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {}
}
